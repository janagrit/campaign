{
  "name": "campaign-integrity-sdet-showcase",
  "version": "2.0.0",
  "private": true,
  "description": "Risk-based Playwright test framework for advertising campaign delivery, billing and reporting integrity.",
  "scripts": {
    "start": "tsx src/server.ts",
    "test": "playwright test --project=no-auth",
    "test:headed": "playwright test --project=no-auth --headed",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "test:smoke": "playwright test --project=no-auth --grep @smoke",
    "test:auth": "playwright test --project=auth-chromium",
    "test:no-auth": "playwright test --project=no-auth",
    "test:api": "playwright test -c playwright.api.config.ts",
    "auth:setup": "tsx scripts/save-auth-state.ts",
    "report": "playwright show-report",
    "report:api": "playwright show-report playwright-report-api",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run test:api"
  },
  "dependencies": {
    "express": "^5.1.0",
    "playwright": "^1.65.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/express": "^5.0.3",
    "@types/node": "^22.15.30",
    "chalk": "^5.6.0",
    "cli-table3": "^0.6.5",
    "dotenv": "^16.4.7",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
